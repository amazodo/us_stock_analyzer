# ============================================
# API KEYS & CREDENTIALS
# ============================================

# NewsAPI (https://newsapi.org)
NEWS_API_KEY=your_newsapi_key_here

# ============================================
# ANALYSIS SETTINGS
# ============================================

# 분석 기간 (일 단위)
ANALYSIS_PERIOD_DAYS=30

# 추천 종목 개수
TOP_N_RECOMMENDATIONS=5

# 목표 상승률 (%)
TARGET_GAIN_PERCENT=5.0

# ============================================
# CACHE SETTINGS
# ============================================

# 캐시 유효 기간 (시간)
CACHE_EXPIRY_HOURS=24

# 로컬 캐싱 활성화 여부
ENABLE_LOCAL_CACHE=true

# 캐시 저장 경로
CACHE_DIR=./data/cache

# ============================================
# LOGGING
# ============================================

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 로그 파일 경로 (옵션)
LOG_FILE=./logs/analysis.log

# ============================================
# TECHNICAL INDICATOR WEIGHTS
# ============================================

# 이동평균 가중치
WEIGHT_MOVING_AVERAGES=24

# 모멘텀 가중치
WEIGHT_MOMENTUM=16

# 변동성 가중치
WEIGHT_VOLATILITY=16

# 거래량/수급 가중치
WEIGHT_VOLUME_FLOW=16

# 피보나치 가중치
WEIGHT_FIBONACCI=8

# 일목균형표 가중치
WEIGHT_ICHIMOKU=20

# ============================================
# QUALITATIVE (SENTIMENT) WEIGHTS  — NEW
# ============================================

# 거시경제 뉴스 가중치
WEIGHT_QUAL_MACRO=30

# 종목별 뉴스 가중치
WEIGHT_QUAL_TICKER=40

# 전문가 의견(Claude) 가중치
WEIGHT_QUAL_EXPERT=30

# ============================================
# ATR / VOLATILITY HARD FILTER  — NEW
# ============================================

# ATR 변동성 필터 임계값 (%)
ATR_FEASIBILITY_THRESHOLD_PCT=2.5

# ============================================
# EARNINGS RISK  — NEW
# ============================================

# 실적 발표 리스크 윈도우 (일수)
EARNINGS_RISK_WINDOW_DAYS=7

# 실적 발표 7일 이내 종목 감점 (포인트)
EARNINGS_RISK_PENALTY_POINTS=5.0

# ============================================
# SECTOR MOMENTUM BONUS  — NEW
# ============================================

# 섹터 모멘텀 가산점 상한 (포인트)
SECTOR_MOMENTUM_MAX_BONUS=5.0

# 섹터 모멘텀 계산용 룩백 기간 (일수)
SECTOR_MOMENTUM_LOOKBACK_DAYS=20

# 섹터 상대 강도 비교 벤치마크 티커
SECTOR_BENCHMARK_TICKER=SPY

# ============================================
# EXPERT OPINION (Claude-based)  — NEW
# ============================================

# 전문가 의견(Claude 분석) 활성화 (Claude API 필요)
EXPERT_OPINION_ENABLED=false

# ============================================
# MARKET REGIME BADGE  — NEW
# ============================================

# 시장 레짐 판단용 이동평균 기간 (일수)
MARKET_REGIME_MA_PERIOD=20

# VIX 경계 수준 (이상)
VIX_CAUTION_LEVEL=20

# VIX 위험 수준 (이상)
VIX_RISK_OFF_LEVEL=30

# ============================================
# STOCK SELECTION
# ============================================

# 분석 대상 종목군 (sp100, nasdaq100, all)
TICKER_SOURCE=sp100

# 최소 시가총액 (십억 달러)
MIN_MARKET_CAP=10

# 최소 일일 거래량 (만 주)
MIN_DAILY_VOLUME=1000

# ============================================
# OUTPUT SETTINGS
# ============================================

# 출력 디렉토리
OUTPUT_DIR=./outputs

# ============================================
# PDF EXPORT  — NEW
# ============================================

# PDF 내보내기 활성화
PDF_ENABLED=true

